{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile Arduino MCU Sketch",
            "type": "shell",
            "command": "arduino-cli compile --fqbn arduino:zephyr:unoq .",
            "options": {
                "cwd": "${workspaceFolder}/app/rpc_test"
            },
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Fast deploy and run",
            "type": "shell",
            "command": "arduino-cli upload --fqbn arduino:zephyr:unoq --port /dev/ttyACM0 .",
            "options": {
                "cwd": "${workspaceFolder}/app/rpc_test"
            },
            "dependsOn": ["Compile Arduino MCU Sketch"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}
